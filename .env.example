# =====================================================================
# KONFIGURASI LINGKUNGAN — SIMKEU Sekolah
# ---------------------------------------------------------------------
# Salin berkas ini menjadi `.env` di folder aplikasi, lalu sesuaikan.
# Berkas `.env` TIDAK ikut ter-commit (lihat .gitignore) sehingga aman
# menyimpan kredensial. Aplikasi membaca .env otomatis saat start
# (env.js) — tidak perlu mengubah kode inti saat pindah hosting/VPS.
# Nilai yang sudah diset dari shell/systemd mengalahkan isi .env.
# =====================================================================

# Zona waktu proses (Date, SQLite localtime, worker WhatsApp, penjadwalan
# pengingat & backup otomatis). Default Asia/Jakarta (WIB, GMT+7).
# Dapat diganti ke Asia/Makassar (WITA) atau Asia/Jayapura (WIT).
# Nilai tak dikenal otomatis kembali ke Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta

# Geser stempel waktu lama (+7 jam ke WIB) satu kali saat start.
# Set 0 bila DATABASE SUDAH sejak awal memakai jam WIB (server WIB).
# TZ_SHIFT_LEGACY=1

# Port HTTP aplikasi
PORT=3120

# Runtime database saat ini masih SQLite. Jangan mengubah ke mysql sebelum
# seluruh helper dan route selesai dipindahkan ke runtime MySQL async.
DB_DRIVER=sqlite

# Lokasi berkas database SQLite (default: ./data/keuangan.sqlite)
DB_PATH=./data/keuangan.sqlite

# Alamat domain publik aplikasi (tanpa garis miring di akhir).
# Dipakai untuk tautan di pesan WhatsApp/OTP, mis.:
# APP_BASE_URL=https://bendaharaspc.vibecoder.co.id/keuangan-sekolah
APP_BASE_URL=

# Endpoint & token layanan unggah media (foto/nota/bukti).
# APP_MEDIA_TOKEN biasanya diisi otomatis oleh platform saat publish.
APP_MEDIA_URL=http://127.0.0.1:4310
APP_MEDIA_TOKEN=

# Gateway WhatsApp untuk kode OTP portal pegawai/orang tua.
# Bila WA_API_URL kosong, aplikasi memakai pengaturan di menu
# Pengaturan Sistem (dan mode uji menampilkan kode di layar).
WA_API_URL=
WA_API_TOKEN=
WA_API_PAYLOAD=form

# Kuota indikator penyimpanan database di dashboard dalam MB (5 GB)
STORAGE_QUOTA_MB=5120

# Folder penyimpanan unggahan lokal; arahkan ke volume persisten saat deploy.
# STORAGE_DIR=./storage

# Berkas .env alternatif (opsional)
# ENV_FILE=/etc/simkeu/.env

# ---------------------------------------------------------------------
# MULTI-TENANT (SaaS) — opsional
# ---------------------------------------------------------------------
# Database control plane: daftar sekolah/tenant, tagihan, sesi login,
# pengaturan QRIS & SMTP. Default: folder yang sama dengan DB_PATH → saas.db
SAAS_DB_PATH=

# Koneksi MySQL untuk pemeriksaan koneksi dan port runtime bertahap.
# Aplikasi utama belum memakai MySQL; DB_DRIVER=mysql tetap menolak startup.
# Isi lewat environment cPanel atau salinan .env lokal; jangan commit password.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_TENANT_DB=
# MYSQL_CONTROL_DB=
# Setelah kredensial tersedia, jalankan `npm run check:mysql` di lingkungan aplikasi.

# Akun Super Admin Pusat (dibuat otomatis saat pertama kali start).
# WAJIB diganti setelah login pertama lewat halaman /super-admin.
SAAS_ADMIN_EMAIL=super@simkeu.id
SAAS_ADMIN_PASSWORD=SuperAdmin2026!

# ---------------------------------------------------------------------
# AUTO-BACKUP TELEGRAM & DOMAIN KHUSUS (opsional)
# ---------------------------------------------------------------------
# Endpoint Bot API (default https://api.telegram.org) — ubah hanya untuk pengujian.
TELEGRAM_API_BASE=

# Target CNAME untuk verifikasi domain khusus sekolah (mis. portal.simkeu.com)
PORTAL_CNAME_TARGET=

# IP publik server (dipakai verifikasi A record domain khusus)
SERVER_IP=

# ---------------------------------------------------------------------
# PAYMENT GATEWAY — KASERA PAY (opsional)
# ---------------------------------------------------------------------
# Kredensial di bawah ini MENANG atas nilai di panel Super Admin.
# Boleh juga diisi lewat panel: Super Admin → QRIS & Harga (gateway pusat)
# atau sekolah → Pembayaran Online (kredensial per sekolah).
#
# API Key dikirim sebagai header:  Authorization: Bearer <KASERA_API_KEY>
KASERA_API_KEY=
# Secret untuk memverifikasi notifikasi pembayaran:
#   kasera-signature-v1 = HMAC-SHA256(body mentah, KASERA_WEBHOOK_SECRET)
KASERA_WEBHOOK_SECRET=
# Base URL API Kasera. Kosongkan untuk default:
#   production → https://pay.kasera.id   ·   sandbox → https://sandbox.kasera.id
KASERA_BASE_URL=
